// secrets.h
#pragma once

// Password for wireless (OTA) firmware uploads. Pick your own.
#define OTA_PASSWORD  "Your_OTA_Password"

// Optional: password of the board's setup Wi-Fi network ("Visualizer-XXXX"), which the board opens
// when it cannot join a network. At least 8 characters. Defaults to "visualizer" if left out.
// #define AP_PASSWORD "Your_Setup_Password"

// Optional, first boot only: a network to start with. The board copies it into flash once, and
// from then on the network is managed from the web UI (Setup tab > Wi-Fi network), so you can
// delete these two lines afterwards to keep the password out of the firmware image.
// #define WIFI_SSID     "Your_Actual_SSID"
// #define WIFI_PASSWORD "Your_Actual_Password"
